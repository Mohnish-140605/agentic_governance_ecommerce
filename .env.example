# Cairn — Full Environment Configuration
# Copy to .env and fill in values before running.
# NEVER commit the .env file (it's in .gitignore).

# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
ENVIRONMENT=development         # development | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text

# ═══════════════════════════════════════════════════════════════
# FRONTEND (Vite public env vars — prefixed with VITE_)
# ═══════════════════════════════════════════════════════════════
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_BUYER_CLIENT_ID=your_buyer_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_MERCHANT_CLIENT_ID=your_merchant_oauth_client_id.apps.googleusercontent.com

# Backend URL consumed by src/services/api.js
VITE_BACKEND_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════════
# BACKEND SECURITY
# ═══════════════════════════════════════════════════════════════
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-GENERATE-32-BYTE-HEX-STRING

# Internal service-to-service API key
INTERNAL_API_KEY=CHANGE-ME-INTERNAL-KEY

# ═══════════════════════════════════════════════════════════════
# CORS (comma-separated list of allowed origins)
# ═══════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
# Local SQLite (default):
DATABASE_URL=sqlite:///./backend/database/cairn.db

# Production PostgreSQL (uncomment and fill):
# DATABASE_URL=postgresql+psycopg2://cairn_user:STRONG_PASSWORD@localhost:5432/cairn_db

# ═══════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_GOVERNANCE=60/minute
RATE_LIMIT_DEFAULT=120/minute

# ═══════════════════════════════════════════════════════════════
# LLM / OLLAMA (open-weight local inference)
# ═══════════════════════════════════════════════════════════════
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=5.0

# ═══════════════════════════════════════════════════════════════
# GOVERNANCE SLA THRESHOLDS
# ═══════════════════════════════════════════════════════════════
GOV_LATENCY_SLA_MS=500.0
LLM_LATENCY_SLA_S=5.0

# ═══════════════════════════════════════════════════════════════
# REDIS (optional — for BullMQ-equivalent background jobs)
# ═══════════════════════════════════════════════════════════════
# REDIS_URL=redis://localhost:6379/0
